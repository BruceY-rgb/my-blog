---
import type { Post } from "../utils/posts";
import { getPostUrl } from "../utils/posts";
import { termPath } from "../utils/site";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const formatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<ul class="m-0 list-none p-0">
  {
    posts.map((post) => (
      <li class="my-6">
        <article>
          <h2 class="m-0 text-lg font-medium">
            <a
              class="text-accent decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline"
              href={getPostUrl(post)}
            >
              {post.data.title}
            </a>
          </h2>
          <time
            class="text-muted-foreground mt-1 block text-sm"
            datetime={post.data.date.toISOString()}
          >
            {formatter.format(post.data.date)}
          </time>
          {post.data.description && (
            <p class="my-2 leading-7">{post.data.description}</p>
          )}
          <div class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-muted-foreground">
            {post.data.tags.slice(0, 4).map((tag) => (
              <a class="hover:text-accent" href={termPath("tags", tag)}>
                #{tag}
              </a>
            ))}
          </div>
        </article>
      </li>
    ))
  }
</ul>
