---
import { site } from "../../astro-paper.config";
import { withBase } from "../utils/site";
---

<footer class="app-layout mt-auto py-8">
  <div
    class="border-border flex flex-wrap justify-between gap-x-4 gap-y-2 border-t pt-6 text-sm text-muted-foreground"
  >
    <span>© 2025–{new Date().getFullYear()} {site.author}</span>
    <span>基于 AstroPaper</span>
    <a class="hover:text-accent" href={withBase("rss.xml")}>RSS</a>
  </div>
</footer>
