---
import { posts as postConfig, site } from "../../astro-paper.config";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PostList from "../components/PostList.astro";
import Base from "../layouts/Base.astro";
import { getPublishedPosts } from "../utils/posts";
import { withBase } from "../utils/site";

const allPosts = await getPublishedPosts();
const recentPosts = allPosts.slice(0, postConfig.perIndex);
---

<Base>
  <Header />
  <main id="main-content" class="app-layout flex-1">
    <section class="border-border border-b py-12 sm:py-16">
      <p class="mb-3 text-sm font-medium text-accent">BruceY · Notebook</p>
      <h1 class="max-w-xl text-3xl leading-tight font-semibold sm:text-5xl">
        把学习与研究，认真写下来。
      </h1>
      <p class="page-copy mt-5">{site.description}</p>
    </section>
    <section class="py-8 sm:py-10">
      <PostList posts={recentPosts} />
      {
        allPosts.length > recentPosts.length && (
          <a
            class="text-accent inline-block pt-4 text-sm font-medium decoration-dashed underline-offset-4 hover:underline"
            href={withBase("posts/")}
          >
            查看全部文章 →
          </a>
        )
      }
    </section>
  </main>
  <Footer />
</Base>
