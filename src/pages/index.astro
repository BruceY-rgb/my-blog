---
import { posts as postConfig, site } from "../../astro-paper.config";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PostList from "../components/PostList.astro";
import Base from "../layouts/Base.astro";
import { getPublishedPosts } from "../utils/posts";
import { withBase } from "../utils/site";

const allPosts = await getPublishedPosts();
const recentPosts = allPosts.slice(0, postConfig.perIndex);
---

<Base>
  <Header />
  <main id="main-content">
    <section class="shell page-intro">
      <span class="eyebrow">BruceY · Notebook</span>
      <h1>把学习与研究，认真写下来。</h1>
      <p>{site.description}</p>
    </section>
    <section class="shell content-section">
      <PostList posts={recentPosts} />
      {
        allPosts.length > recentPosts.length && (
          <a class="text-link" href={withBase("posts/")}>
            查看全部文章 →
          </a>
        )
      }
    </section>
  </main>
  <Footer />
</Base>
