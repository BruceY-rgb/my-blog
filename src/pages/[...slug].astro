---
import { render } from "astro:content";
import legacyRedirects from "../data/legacy-redirects.json";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Base from "../layouts/Base.astro";
import { getPostUrl, getPublishedPosts, type Post } from "../utils/posts";
import { termPath, withBase } from "../utils/site";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const postPaths = posts.map((post) => ({
    params: { slug: post.data.legacyPath },
    props: { post },
  }));
  const redirectPaths = legacyRedirects.map(({ from }) => ({
    params: { slug: from },
    props: { redirectTo: withBase("archives/") },
  }));
  return [...postPaths, ...redirectPaths];
}

const { post, redirectTo } = Astro.props as { post?: Post; redirectTo?: string };
if (redirectTo) return Astro.redirect(redirectTo, 301);
if (!post) throw new Error("Missing post data.");
const { Content } = await render(post);
const postUrl = getPostUrl(post);
const formatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const canonical = new URL(postUrl, Astro.site).href;
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { "@type": "Person", name: "BruceY" },
  mainEntityOfPage: canonical,
};
---

<Base
  title={`${post.data.title} | BruceY's Blog`}
  description={post.data.description}
  image={post.data.cover}
>
  <Fragment slot="head"
    ><script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    /></Fragment
  >
  <Header />
  <main id="main-content">
    <header class="shell article-header">
      <span class="eyebrow">{post.data.categories[0] ?? "文章"}</span>
      <h1>{post.data.title}</h1>
      <div class="article-meta">
        <time datetime={post.data.date.toISOString()}
          >{formatter.format(post.data.date)}</time
        >{post.data.authors && ` · ${post.data.authors}`}{
          post.data.venue && ` · ${post.data.venue}`
        }
      </div>
      <div class="taxonomy">
        {
          post.data.categories.map((category) => (
            <a href={termPath("categories", category)}>{category}</a>
          ))
        }{post.data.tags.map((tag) => <a href={termPath("tags", tag)}>#{tag}</a>)}
      </div>
    </header>
    <article class="shell article"><Content /></article>
  </main>
  <Footer />
</Base>
