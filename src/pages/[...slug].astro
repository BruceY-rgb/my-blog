---
import { render } from "astro:content";
import legacyRedirects from "../data/legacy-redirects.json";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Base from "../layouts/Base.astro";
import { getPostUrl, getPublishedPosts, type Post } from "../utils/posts";
import { termPath, withBase } from "../utils/site";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const postPaths = posts.map((post) => ({
    params: { slug: post.data.legacyPath },
    props: { post },
  }));
  const redirectPaths = legacyRedirects.map(({ from }) => ({
    params: { slug: from },
    props: { redirectTo: withBase("archives/") },
  }));
  return [...postPaths, ...redirectPaths];
}

const { post, redirectTo } = Astro.props as { post?: Post; redirectTo?: string };
if (redirectTo) return Astro.redirect(redirectTo, 301);
if (!post) throw new Error("Missing post data.");
const { Content } = await render(post);
const postUrl = getPostUrl(post);
const formatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const canonical = new URL(postUrl, Astro.site).href;
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { "@type": "Person", name: "BruceY" },
  mainEntityOfPage: canonical,
};
---

<Base
  title={`${post.data.title} | BruceY's Blog`}
  description={post.data.description}
  image={post.data.cover}
>
  <Fragment slot="head"
    ><script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    /></Fragment
  >
  <Header />
  <main id="main-content" class="app-layout flex-1">
    <header class="border-border border-b py-12 sm:py-16">
      <p class="mb-3 text-sm font-medium text-accent">
        {post.data.categories[0] ?? "文章"}
      </p>
      <h1 class="max-w-3xl text-3xl leading-tight font-semibold sm:text-5xl">
        {post.data.title}
      </h1>
      <div class="mt-5 text-sm text-muted-foreground">
        <time datetime={post.data.date.toISOString()}
          >{formatter.format(post.data.date)}</time
        >{post.data.authors && ` · ${post.data.authors}`}{
          post.data.venue && ` · ${post.data.venue}`
        }
      </div>
      <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-sm text-muted-foreground">
        {
          post.data.categories.map((category) => (
            <a class="hover:text-accent" href={termPath("categories", category)}>
              {category}
            </a>
          ))
        }{
          post.data.tags.map((tag) => (
            <a class="hover:text-accent" href={termPath("tags", tag)}>
              #{tag}
            </a>
          ))
        }
      </div>
    </header>
    <article class="article mx-auto max-w-3xl py-10 sm:py-14"><Content /></article>
  </main>
  <Footer />
</Base>
