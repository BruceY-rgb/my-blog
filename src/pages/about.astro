---
import { getEntry, render } from "astro:content";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Base from "../layouts/Base.astro";

const page = await getEntry("pages", "about");
if (!page) throw new Error("Migrated about page is missing.");
const { Content } = await render(page);
---

<Base title={`关于 | BruceY's Blog`} description={page.data.description}
  ><Header /><main id="main-content">
    <header class="shell article-header">
      <span class="eyebrow">About</span><h1>{page.data.title}</h1>
    </header><article class="shell article"><Content /></article>
  </main><Footer /></Base
>
