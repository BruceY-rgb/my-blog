---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import PostList from "../../components/PostList.astro";
import Base from "../../layouts/Base.astro";
import { getPublishedPosts } from "../../utils/posts";

const allPosts = await getPublishedPosts();
---

<Base
  title="全部文章 | BruceY's Blog"
  description="BruceY 的全部技术文章、课程笔记与研究记录。"
>
  <Header />
  <main id="main-content" class="app-layout flex-1">
    <section class="border-border border-b py-12 sm:py-16">
      <p class="mb-3 text-sm font-medium text-accent">Writing</p><h1 class="page-title">
        全部文章
      </h1><p class="page-copy">按发布日期倒序排列。</p>
    </section>
    <section class="py-8 sm:py-10"><PostList posts={allPosts} /></section>
  </main>
  <Footer />
</Base>
