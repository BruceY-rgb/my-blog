---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import PostList from "../../components/PostList.astro";
import Base from "../../layouts/Base.astro";
import { getPublishedPosts, getTerms } from "../../utils/posts";
import { termSlug } from "../../utils/site";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getTerms(posts, "categories").map((term) => ({
    params: { term: termSlug(term) },
    props: { term, posts: posts.filter((post) => post.data.categories.includes(term)) },
  }));
}

const { term, posts } = Astro.props;
---

<Base title={`${term} | 分类 | BruceY's Blog`}
  ><Header /><main id="main-content" class="app-layout flex-1">
    <section class="border-border border-b py-12 sm:py-16">
      <p class="mb-3 text-sm font-medium text-accent">Category</p><h1
        class="page-title"
      >
        {term}
      </h1><p class="page-copy">
        {posts.length} 篇公开文章。
      </p>
    </section><section class="py-8 sm:py-10">
      <PostList posts={posts} />
    </section>
  </main><Footer /></Base
>
