---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import PostList from "../../components/PostList.astro";
import Base from "../../layouts/Base.astro";
import { getPublishedPosts } from "../../utils/posts";

const posts = await getPublishedPosts();
const byYear = Map.groupBy(posts, (post) => String(post.data.date.getFullYear()));
---

<Base title="归档 | BruceY's Blog">
  <Header />
  <main id="main-content" class="app-layout flex-1">
    <section class="border-border border-b py-12 sm:py-16">
      <p class="mb-3 text-sm font-medium text-accent">Archive</p><h1 class="page-title">
        归档
      </h1><p class="page-copy">按年份回看全部公开记录。</p>
    </section>
    <section class="py-8 sm:py-10">
      {
        Array.from(byYear.entries())
          .sort(([a], [b]) => b.localeCompare(a))
          .map(([year, entries]) => (
            <section class="mb-12">
              <>
                <h2 class="text-xl font-semibold">
                  {year}
                  <small class="text-muted-foreground"> · {entries.length}</small>
                </h2>
                <PostList posts={entries} />
              </>
            </section>
          ))
      }
    </section>
  </main>
  <Footer />
</Base>
